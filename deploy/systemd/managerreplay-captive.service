[Unit]
Description=ManagerReplay captive-portal redirect (Wi-Fi auto-open)
After=network.target

[Service]
Type=simple
User=rocha
Environment=MANAGERREPLAY_CAPTIVE_TARGET=https://10.42.0.1:8443
ExecStart=/usr/bin/python3 /home/rocha/managerreplay/captive-portal/redirect_server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
